{
  "manifest_version": 3,
  "name": "Auto Sort Tabs",
  "version": "0.1.0",
  "description": "Automatically groups tabs into native tab groups and keeps them sorted.",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["tabs", "tabGroups", "storage"],
  "action": {
    "default_title": "Auto Sort Tabs",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" },
    "default_popup": "ui/popup.html"
  },
  "options_ui": { "page": "ui/options.html", "open_in_tab": true },
  "commands": {
    "organize-now": {
      "suggested_key": { "default": "Alt+Shift+O" },
      "description": "Group and sort the tabs of the current window"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "auto-sort-tabs@tilopes.github.io",
      "strict_min_version": "139.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
